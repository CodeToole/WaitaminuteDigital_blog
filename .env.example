# Django secret key used for cryptographic signing. Keep this private and unique in production.
DJANGO_SECRET_KEY=your-secret-key-here

# Set to True during local development and False in production.
DEBUG=True

# Comma-separated hostnames allowed to serve the site. Add your production domain in deployment.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Name of your PostgreSQL database.
DB_NAME=your-db-name

# PostgreSQL username for the app.
DB_USER=your-db-user

# PostgreSQL password for the database user.
DB_PASSWORD=your-db-password

# Hostname for the PostgreSQL server.
DB_HOST=localhost

# Port used by PostgreSQL.
DB_PORT=5432
